# Production values must be supplied by the deployment platform.
# Set APP_ENV=production for deployment.
APP_ENV=production
# Never commit a real .env file or secret values.

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=replace-with-a-long-random-production-secret

# Browser origin served by Vercel.
CORS_ORIGINS=https://shop-website-three-inky.vercel.app
FRONTEND_URL=https://shop-website-three-inky.vercel.app

# Server-side Flask sessions.
# Redis is required in production so sessions survive Render restarts/redeploys.
SESSION_TYPE=redis
REDIS_URL=redis://USER:PASSWORD@HOST:6379
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true
SESSION_FILE_DIR=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google must redirect through the Vercel same-origin /api proxy.
GOOGLE_REDIRECT_URI=https://shop-website-three-inky.vercel.app/api/auth/google/callback

SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_SERVICE_ROLE_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_API_BASE_URL=https://api.mailgun.net
MAILGUN_TIMEOUT=10
