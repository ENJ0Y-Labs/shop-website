# Production values must be supplied by the deployment platform.
# Set APP_ENV=production for deployment. This enables secure cross-site cookies by default.
APP_ENV=production
# Never commit a real .env file or secret values.

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=replace-with-a-long-random-production-secret

# Comma-separated exact browser origins. Do not include a trailing slash.
CORS_ORIGINS=https://shop.example.com
FRONTEND_URL=https://shop.example.com

# Server-side Flask sessions. Filesystem is suitable for local development only.
SESSION_TYPE=filesystem
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true
SESSION_FILE_DIR=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_SERVICE_ROLE_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_API_BASE_URL=https://api.mailgun.net
MAILGUN_TIMEOUT=10
